#include "keys_de_swiss.h"
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// / {
//     chosen { zmk,matrix_transform = &default_transform; };
// };

&lt {
    flavor = "balanced";
    quick-tap-ms = <175>;
    tapping-term-ms = <190>;
};

/ {
    /* input config for mouse move mode */

    trackball_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <0 1 2>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <2>;

        // bindings = <&ib_toggle_layer 7>;
    };

    /* input config for snipe mode */

    trackball_snipe_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <4>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <4>;
    };

    /* input config for mouse scroll mode */

    trackball_scroll_listener {
        compatible = "zmk,input-behavior-listener";
        device = <&vtrackball>;
        layers = <3>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_MISC>;
        y-input-code = <INPUT_REL_WHEEL>;
        y-invert;
        bindings = <&ib_wheel_scaler 1 14>;
    };

    /* define a resolution down scaler only for INPUT_REL_WHEEL */

    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };

    /* adjust cooldown waiting period for mouse key layer after activated */

    ib_toggle_layer: ib_toggle_layer {
        compatible = "zmk,input-behavior-tog-layer";
        #binding-cells = <1>;
        time-to-live-ms = <750>;
    };

    // #define QUERTZ    0
    // #define NUMBERS   1
    // #define NAV-FUN   2
    // #define MAC       3
    // #define MAC-NUM   4
    // #define MAC-NAV   5
    // #define GAME      6
    // #define GAME-NUM  7
    // #define GAME-NAV  8
    // #define SCROLL    9
    // #define SNIPER   10
    // #define FN       11

    combos {
        compatible = "zmk,combos";

        rh_leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <43 44>;
        };

        rh_rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <44 45>;
        };

        rh_middleClick {
            bindings = <&mkp MCLK>;
            key-positions = <44 45 43>;
        };

        lh_leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <40 39>;
        };

        lh_rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <38 39>;
        };

        lh_middleClick {
            bindings = <&mkp MCLK>;
            key-positions = <38 39 40>;
        };

        CAPZ {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 25>;
        };

        settings {
            bindings = <&to 5>;
            key-positions = <18 20 23>;
        };

        lh_prevClick {
            bindings = <&mkp MB4>;
            key-positions = <40 38>;
        };

        lh_nextClick {
            bindings = <&mkp MB5>;
            key-positions = <40 37>;
        };

        rh_prevClick {
            bindings = <&mkp MB4>;
            key-positions = <43 45>;
        };

        rh_nextClick {
            bindings = <&mkp MB5>;
            key-positions = <43 46>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54 51 52 55>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <48 49 50 53 54 51 52 55 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp GRAVE                 &kp N1   &kp N2   &kp N3           &kp N4           &kp N5            &kp N6            &kp N7           &kp N8        &kp N9         &kp N0      &kp DEL
&kp TAB                   &kp Q    &kp W    &kp E            &kp R            &kp T             &kp Y             &kp U            &kp I         &kp O          &kp P       &kp EQUAL
&hml LEFT_CONTROL ESCAPE  &lt 3 A  &lt 4 S  &hml LEFT_GUI D  &hml LEFT_ALT F  &kp G             &kp H             &hmr LEFT_ALT J  &hmr LGUI K   &lt 4 L        &lt 3 SEMI  &hmr LEFT_SHIFT SQT
&kp BACKSLASH             &kp Z    &kp X    &kp C            &kp V            &kp B             &kp N             &kp M            &kp DE_COMMA  &kp DE_PERIOD  &kp SLASH   &kp MINUS
                                            &tog 2           &lt 1 SPACE      &kp LEFT_SHIFT    &kp LEFT_CONTROL  &kp BACKSPACE
                                                             &kp LEFT_ALT     &kp LEFT_GUI      &kp ENTER
            >;
        };

        symbols {
            bindings = <
&trans          &trans            &trans                &trans                 &trans             &trans             &trans         &trans     &trans  &trans  &trans     &trans
&kp TILDE       &kp EXCLAMATION   &kp AT_SIGN           &kp POUND              &kp DOLLAR         &kp PERCENT        &kp PLUS       &kp N7     &kp N8  &kp N9  &kp MINUS  &kp BACKSLASH
&kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE    &kp EQUAL      &kp N4     &kp N5  &kp N6  &kp COLON  &kp DQT
&kp AMPERSAND   &kp CARET         &kp LESS_THAN         &kp GREATER_THAN       &kp UNDERSCORE     &kp PIPE           &kp ASTERISK   &kp N1     &kp N2  &kp N3  &kp FSLH   &kp QUESTION
                                                        &trans                 &trans             &trans             &kp BACKSPACE  &kp DE_N0
                                                                               &trans             &trans             &trans
            >;
        };

        navigation {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans          &trans    &trans    &trans   &trans     &trans   &trans
&trans  &kt F1  &kp F2     &kp F3     &kp F4     &kp F5          &kp F6    &kp F7    &kp F8   &kp F9     &kp F10  &kp F11
&trans  &tog 3  &mkp RCLK  &mkp MCLK  &mkp LCLK  &tog 4          &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT  &trans   &kp F12
&trans  &trans  &trans     &mkp MB5   &mkp MB4   &trans          &trans    &kp HOME  &kp END  &trans     &trans   &trans
                           &trans     &trans     &trans          &trans    &trans
                                      &kp LALT   &kp LEFT_GUI    &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        sniper {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        settings {
            bindings = <
&bootloader  &none  &none  &none  &none  &none    &ext_power EP_TOG  &none         &to 0         &none         &sys_reset    &bootloader
&none        &none  &none  &none  &none  &none    &none              &to 0         &none         &none         &none         &none
&none        &none  &none  &none  &none  &none    &bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none        &none  &none  &none  &none  &none    &bt BT_CLR_ALL     &none         &none         &none         &none         &none
                           &none  &none  &none    &none              &none
                                  &none  &none    &none
            >;
        };

        gaming {
            bindings = <
&none  &none      &none  &none  &none      &none    &none  &none     &none     &none      &none  &none
&none  &kp TAB    &kp Q  &kp W  &kp E      &kp R    &none  &none     &kp UP    &none      &none  &none
&none  &kp ESC    &kp A  &kp S  &kp D      &kp F    &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&none  &kp LCTRL  &kp Z  &kp X  &kp C      &kp V    &none  &none     &none     &none      &none  &none
                         &to 0  &kp SPACE  &none    &none  &none
                                &none      &none    &none
            >;
        };
    };
};
